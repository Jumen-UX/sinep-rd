NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Alternative legacy public key name supported by src/lib/supabase/config.ts
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Canonical public origin for Supabase Auth redirect URLs and public metadata.
APP_BASE_URL=http://localhost:3000

# Search-engine indexing is fail-closed. Both values must be true only after
# the public-launch checklist and institutional approval are complete.
PUBLIC_INDEXING_ENABLED=false
PUBLIC_LAUNCH_APPROVED=false

# Server-only. Required for admin user invitation, account recovery and the
# operator-only E2E account lifecycle. Never expose this as NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=

# Optional manual Playwright execution. Leave E2E_BASE_URL empty to start the local Next.js server.
E2E_BASE_URL=
# Optional administrative flow. Use a dedicated non-production test account.
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=

# Optional read-only access matrix. Store as a protected secret in CI, never in this file.
# Every profile: label, email, password and expectedState.
# expectedState values: ready, onboarding, no_role or blocked.
# Ready profiles additionally require navigationRole, expectedScopeLabel,
# expectedNavigation { visible, hidden, readOnly }, ownEntityId,
# forbiddenEntityId and optional minimumVisibleDioceses.
# The complete matrix requires all four states, administrator + viewer navigation
# and two ready profiles with bidirectional A↔B scope isolation.
E2E_ACCESS_PROFILES_JSON=

# Operator-only provisioning of the protected access matrix. The command fails
# unless the confirmation is exact, the email domain is reserved and both
# entities use test-* slugs. The output directory is ignored by Git.
E2E_PROVISION_CONFIRM=
E2E_ACCESS_EMAIL_DOMAIN=example.test
E2E_ACCESS_ENTITY_A_SLUG=test-arquidiocesis-ozama
E2E_ACCESS_ENTITY_B_SLUG=test-diocesis-monte-azul
E2E_ACCESS_OUTPUT=.secrets/e2e-access-profiles.json
E2E_ALLOW_NON_RESERVED_EMAIL_DOMAIN=false
E2E_ALLOW_NON_TEST_ENTITIES=false

# Operator-only deprovisioning. suspend is the normal mode and removes roles;
# delete additionally requires E2E_DELETE_CONFIRM=DELETE_NON_PRODUCTION_E2E_USERS.
E2E_DEPROVISION_CONFIRM=
E2E_DEPROVISION_MODE=suspend
E2E_DELETE_CONFIRM=

# Explicitly guarded mutating E2E. Never enable against production.
E2E_ALLOW_MUTATIONS=false
# Existing person in the same non-production database, used to verify a real noop.
E2E_PERSON_REFERENCE_CODE=
E2E_PERSON_FIRST_NAME=
E2E_PERSON_LAST_NAME=
